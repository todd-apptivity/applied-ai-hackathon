# Copy to .env.local and fill in. Never commit real values.

# --- Clio Manage connection ---
# Create a developer app at https://app.clio.com/settings/developer_applications
# Grant it READ permissions only on: Users, Practice Areas, Contacts, Matters,
# Custom Fields, Documents, Notes, Communications, Tasks, Calendars, Activities.
# Clio has no OAuth `scope` parameter; permissions live on the app itself.

CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=

# Must match the redirect URI registered on the Clio app, exactly.
CLIO_REDIRECT_URI=http://localhost:3000/api/clio/callback

# us (app.clio.com) | eu | ca | au
CLIO_REGION=us

# Where the OAuth callback lands once tokens are stored.
CLIO_POST_CONNECT_PATH=/clio

# Token filename inside the gitignored .clio/ directory.
# Swap FileTokenStore for a database row when this goes multi-tenant.
CLIO_TOKEN_FILE=tokens.json

# --- Case-file RAG ---
# Embeddings. Voyage AI is used when VOYAGE_API_KEY is set.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Set to "hash" for offline testing without an API key (low retrieval quality).
EMBEDDING_PROVIDER=

# OCR for scanned PDF pages (only used with `npm run rag:ingest -- --ocr`).
ANTHROPIC_API_KEY=
RAG_OCR_MODEL=claude-opus-5-5

# Where the SQLite index lives, and the firm's time zone for turning Clio's UTC timestamps into dates.
RAG_DB_PATH=data/rag.sqlite
RAG_TIME_ZONE=America/New_York

# Bearer token required by POST /api/rag/search. Required in production.
RAG_API_TOKEN=
