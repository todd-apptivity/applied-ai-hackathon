# Clio Manage connection — copy to .env.local and fill in.
#
# Create a developer app at https://app.clio.com/settings/developer_applications
# Grant it READ permissions only on: Users, Practice Areas, Contacts, Matters,
# Custom Fields, Documents, Notes, Communications, Tasks, Calendars, Activities.
# Clio has no OAuth `scope` parameter — permissions live on the app itself.

CLIO_CLIENT_ID=
CLIO_CLIENT_SECRET=

# Must match the redirect URI registered on the Clio app, exactly.
CLIO_REDIRECT_URI=http://localhost:3000/api/clio/callback

# us (app.clio.com) | eu | ca | au
CLIO_REGION=us

# Where the OAuth callback lands once tokens are stored.
CLIO_POST_CONNECT_PATH=/clio

# Token filename inside the gitignored .clio/ directory.
# Swap FileTokenStore for a database row when this goes multi-tenant.
CLIO_TOKEN_FILE=tokens.json

# --- Retrieval ------------------------------------------------------------
# Voyage AI powers embeddings and reranking (Anthropic has no embeddings
# endpoint). Get a key at https://dash.voyageai.com
VOYAGE_API_KEY=

# Claude handles extraction and composition.
ANTHROPIC_API_KEY=

# Local SQLite cache + retrieval index, inside the gitignored .data/ directory.
RAG_DB_PATH=.data/ninety.db

# Changing the embedding model re-embeds every chunk on the next sync.
VOYAGE_EMBED_MODEL=voyage-4-large
VOYAGE_RERANK_MODEL=rerank-2.5

# --- Case chat ------------------------------------------------------------
# anthropic (default) | local
CHAT_PROVIDER=anthropic

# Which Claude model answers. Needs ANTHROPIC_API_KEY above.
CHAT_MODEL=claude-sonnet-5

# Only read when CHAT_PROVIDER=local. Point at any OpenAI-compatible endpoint:
# vLLM, llama.cpp --server, or Ollama (http://localhost:11434/v1).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
# vLLM and llama.cpp ignore this; Ollama needs any non-empty value.
LOCAL_LLM_API_KEY=

# Tool-call rounds the agent may take per turn. Defaults to 6 on Claude and 4
# on a local model, which loses the thread sooner.
CHAT_MAX_STEPS=
