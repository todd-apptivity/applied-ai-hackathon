# Copy to .env.local and fill in. Never commit real values.

# Clio (read-only). An OAuth access token from a Clio app that requests read scopes only.
CLIO_ACCESS_TOKEN=
# Region base URL: https://app.clio.com (US), https://eu.app.clio.com, https://ca.app.clio.com, https://au.app.clio.com
CLIO_BASE_URL=https://app.clio.com

# Embeddings. Voyage AI is used when VOYAGE_API_KEY is set.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
# Set to "hash" for offline testing without an API key (low retrieval quality).
EMBEDDING_PROVIDER=

# OCR for scanned PDF pages (only used with `npm run rag:ingest -- --ocr`).
ANTHROPIC_API_KEY=
RAG_OCR_MODEL=claude-opus-5-5

# Where the SQLite index lives, and the firm's time zone for turning Clio's UTC timestamps into dates.
RAG_DB_PATH=data/rag.sqlite
RAG_TIME_ZONE=America/New_York

# Bearer token required by POST /api/rag/search. Required in production.
RAG_API_TOKEN=
